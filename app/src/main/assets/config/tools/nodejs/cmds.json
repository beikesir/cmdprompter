{
  "commands": [
    {
      "id": "node-run",
      "name": "运行脚本",
      "desc": "使用 node 执行本地 JS 文件",
      "tags": ["Node.js", "运行"],
      "template": "node {{file}}",
      "params": [
        {
          "key": "file",
          "label": "入口文件",
          "type": "text",
          "default": "index.js"
        }
      ]
    },
    {
      "id": "node-eval",
      "name": "内联代码",
      "desc": "不落地文件，直接执行一段 JS 代码",
      "tags": ["Node.js", "调试"],
      "template": "node -e '{{code}}'",
      "params": [
        {
          "key": "code",
          "label": "代码",
          "type": "text",
          "default": "console.log(process.version)"
        }
      ]
    },
    {
      "id": "npx-run",
      "name": "npx 临时运行",
      "desc": "免安装临时执行 npm 包提供的命令",
      "tags": ["Node.js", "npx"],
      "template": "npx {{package}} {{args}}",
      "params": [
        {
          "key": "package",
          "label": "包名",
          "type": "text",
          "default": "create-react-app"
        },
        {
          "key": "args",
          "label": "参数",
          "type": "text",
          "default": "my-app",
          "hint": "传给命令的参数"
        }
      ]
    }
  ],
  "groups": []
}
