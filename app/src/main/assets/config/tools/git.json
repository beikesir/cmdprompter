{
  "platform": "Git",
  "commands": [
    {
      "id": "git-commit-push",
      "name": "提交并推送",
      "desc": "本地提交并推送到远程",
      "tags": ["Git", "部署流程"],
      "template": "git commit -m '{{message}}' && git push origin {{branch}}",
      "params": [
        {
          "key": "message",
          "label": "提交信息",
          "type": "text",
          "default": "fix: bug",
          "hint": "用单引号包裹"
        },
        {
          "key": "branch",
          "label": "分支",
          "type": "enum",
          "options": ["main", "develop", "feature"],
          "default": "main"
        }
      ],
      "docRef": "git"
    },
    {
      "id": "git-pull",
      "name": "拉取最新代码",
      "desc": "从远程拉取并合并",
      "tags": ["Git", "日常"],
      "template": "git pull origin {{branch}}",
      "params": [
        {
          "key": "branch",
          "label": "分支",
          "type": "text",
          "default": "main"
        }
      ],
      "docRef": "git"
    },
    {
      "id": "git-switch-branch",
      "name": "切换分支",
      "desc": "创建并切换到指定分支",
      "tags": ["Git", "日常"],
      "template": "git checkout -b {{branch}}",
      "params": [
        {
          "key": "branch",
          "label": "分支名",
          "type": "text",
          "default": "feature/new",
          "hint": "加 -b 表示新建"
        }
      ],
      "docRef": "git"
    }
  ],
  "groups": [
    {
      "id": "daily-git",
      "name": "日常开发提交流程",
      "tags": ["开发", "日常"],
      "cmdIds": ["git-pull", "git-commit-push"],
      "order": ["git-pull", "git-commit-push"]
    }
  ]
}
