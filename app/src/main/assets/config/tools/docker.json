{
  "platform": "Docker",
  "commands": [
    {
      "id": "docker-run",
      "name": "运行容器",
      "desc": "以后台方式启动一个新容器",
      "tags": ["Docker", "部署流程"],
      "template": "docker run -d --name {{name}} -p {{hostPort}}:{{containerPort}} {{image}}",
      "params": [
        {
          "key": "name",
          "label": "容器名",
          "type": "text",
          "default": "my-nginx",
          "hint": "容器唯一名称"
        },
        {
          "key": "hostPort",
          "label": "宿主机端口",
          "type": "text",
          "default": "8080"
        },
        {
          "key": "containerPort",
          "label": "容器端口",
          "type": "text",
          "default": "80"
        },
        {
          "key": "image",
          "label": "镜像",
          "type": "text",
          "default": "nginx:latest",
          "hint": "镜像名:标签"
        }
      ],
      "docRef": "docker"
    },
    {
      "id": "docker-logs",
      "name": "查看容器日志",
      "desc": "实时跟踪容器输出",
      "tags": ["Docker", "排查"],
      "template": "docker logs -f --tail {{lines}} {{name}}",
      "params": [
        {
          "key": "lines",
          "label": "行数",
          "type": "text",
          "default": "100"
        },
        {
          "key": "name",
          "label": "容器名",
          "type": "text",
          "default": "my-nginx"
        }
      ],
      "docRef": "docker"
    }
  ],
  "groups": [
    {
      "id": "deploy-web",
      "name": "快速部署 Web 服务",
      "tags": ["部署", "Web"],
      "cmdIds": ["docker-run", "git-pull", "ssh-connect"],
      "order": ["docker-run", "git-pull", "ssh-connect"]
    }
  ]
}
