{
  "platform": "文件系统",
  "commands": [
    {
      "id": "fs-find",
      "name": "查找文件",
      "desc": "按名称模式递归查找文件",
      "tags": ["文件系统", "查找"],
      "template": "find {{path}} -type {{type}} -name '{{pattern}}'",
      "params": [
        {
          "key": "path",
          "label": "搜索目录",
          "type": "text",
          "default": ".",
          "hint": "起始路径"
        },
        {
          "key": "type",
          "label": "类型",
          "type": "enum",
          "options": ["f", "d", "l"],
          "default": "f"
        },
        {
          "key": "pattern",
          "label": "名称模式",
          "type": "text",
          "default": "*.log",
          "hint": "支持通配符"
        }
      ],
      "docRef": "filesystem"
    },
    {
      "id": "fs-chmod",
      "name": "修改权限",
      "desc": "修改文件或目录的访问权限",
      "tags": ["文件系统", "权限"],
      "template": "chmod {{mode}} {{path}}",
      "params": [
        {
          "key": "mode",
          "label": "权限",
          "type": "enum",
          "options": ["755", "644", "600", "777"],
          "default": "755"
        },
        {
          "key": "path",
          "label": "路径",
          "type": "text",
          "default": "./script.sh"
        }
      ],
      "docRef": "filesystem"
    },
    {
      "id": "fs-tar",
      "name": "打包压缩",
      "desc": "将目录打包为 tar.gz 归档",
      "tags": ["文件系统", "归档"],
      "template": "tar -czf {{output}} {{source}}",
      "params": [
        {
          "key": "output",
          "label": "输出文件",
          "type": "text",
          "default": "archive.tar.gz"
        },
        {
          "key": "source",
          "label": "源目录",
          "type": "text",
          "default": "./dist"
        }
      ],
      "docRef": "filesystem"
    }
  ],
  "groups": []
}
