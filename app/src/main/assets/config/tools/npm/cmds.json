{
  "commands": [
    {
      "id": "npm-init",
      "name": "初始化项目",
      "desc": "使用默认配置快速生成 package.json",
      "tags": ["npm", "初始化"],
      "template": "npm init -y",
      "params": []
    },
    {
      "id": "npm-install",
      "name": "安装依赖",
      "desc": "安装依赖包并写入 package.json",
      "tags": ["npm", "依赖"],
      "template": "npm install {{mode}} {{package}}",
      "params": [
        {
          "key": "mode",
          "label": "安装方式",
          "type": "enum",
          "options": ["--save", "--save-dev", "--no-save"],
          "default": "--save"
        },
        {
          "key": "package",
          "label": "包名",
          "type": "text",
          "default": "lodash",
          "hint": "可带版本号"
        }
      ]
    },
    {
      "id": "npm-run",
      "name": "运行脚本",
      "desc": "执行 package.json 中定义的脚本",
      "tags": ["npm", "脚本"],
      "template": "npm run {{script}}",
      "params": [
        {
          "key": "script",
          "label": "脚本名",
          "type": "enum",
          "options": ["dev", "build", "test", "start"],
          "default": "dev"
        }
      ]
    }
  ],
  "groups": []
}
